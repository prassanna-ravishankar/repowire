# Copy to ~/.repowire/config.yaml
daemon:
  host: "127.0.0.1"
  port: 8377
  auth_token: ""
  spawn:
    commands:
      claude-code: "claude --dangerously-skip-permissions"
      codex: "codex --dangerously-bypass-approvals-and-sandbox"
    allowed_paths: []
  mcp_http:
    enabled: true
    bind: "localhost-only"
    require_auth: true

relay:
  enabled: false
  url: "wss://repowire.io"
  api_key: ""

telegram:
  bot_token: ""
  chat_id: ""

slack:
  bot_token: ""
  app_token: ""
  channel_id: ""

updates:
  check_enabled: false
